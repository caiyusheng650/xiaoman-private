    <string name="assist_guide_default_title">1. Choose the default assistant</string>
    <string name="assist_guide_default_body">Tap Open assistant settings, then select Xiaoman as the default digital assistant.</string>
    <string name="assist_guide_launch_title">2. Choose how to launch</string>
    <string name="assist_guide_launch_body">If your phone supports it, set a long press of the power or side button to launch the assistant in system gesture settings. You can also try the system assistant gesture.</string>
    <string name="assist_guide_type_title">3. Type and send</string>
    <string name="assist_guide_type_body">The keyboard opens when you invoke Xiaoman. Type your message and tap the send arrow. Follow progress at the top of the screen, then read the reply in the notification or chat.</string>
    <string name="settings_chat_description">Handles conversation and decides what to do next. A multimodal model with image input is required for chat pictures.</string>
    <string name="settings_operator_description">Reads the screen and performs actions. Requires image support.</string>
