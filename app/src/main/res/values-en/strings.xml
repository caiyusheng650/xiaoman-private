    <string name="guide_accessibility_title">Accessibility</string>
    <string name="guide_accessibility_detail">Let Xiaoman operate other apps when you ask</string>
    <string name="guide_accessibility_body">Open Accessibility settings and find Xiaoman under Installed apps or Downloaded services. Turn on the service, return to Xiaoman, and try asking it to open an app.</string>
    <string name="guide_accessibility_open">Open Accessibility settings</string>
    <string name="guide_notifications_title">Notifications</string>
    <string name="guide_notifications_detail">Read final replies from background tasks</string>
    <string name="guide_notifications_body">Open notification settings for Xiaoman and allow notifications. If your phone shows notification categories, enable Chat replies and task results. Tap a result notification to return to chat.</string>
    <string name="guide_notifications_open">Open notification settings</string>
    <string name="guide_models_title">Model setup</string>
    <string name="guide_models_detail">Connect the chat and phone control models</string>
    <string name="guide_chat_model_body">Enter the API address and key from your provider. Fetch and choose a multimodal chat model that accepts image input. It handles normal conversation and the pictures you send in chat. If no list is available, enter the model ID from your provider manually.</string>
    <string name="guide_operator_model_body">If both models use the same provider, copy the chat model address and key, then choose a model that accepts images. Tap Save after configuring both models.</string>
    <string name="guide_automation_title">Task behavior</string>
    <string name="guide_automation_detail">Set a step limit and choose whether to save successful steps</string>
    <string name="guide_steps_body">This limits how many actions Xiaoman can try in one phone task. If a task reaches the limit before it finishes, you can raise it and tap Save.</string>
    <string name="guide_learn_body">When enabled, Xiaoman can save successful steps as a skill for next time. Review saved skills in the Capabilities tab.</string>
